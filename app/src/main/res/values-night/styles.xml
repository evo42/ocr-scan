<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Colors -->
        <item name="colorPrimary">@color/bankpay_primary</item>
        <item name="colorPrimaryDark">@color/bankpay_secondary</item>
        <item name="colorAccent">@color/bankpay_accent</item>
        <item name="colorSurface">@color/cardBackground</item>
        <item name="android:colorBackground">@color/colorActivityWhiteBackground</item>
        
        <!-- Status Bar -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/colorActivityWhiteBackground</item>
        
        <!-- Typography -->
        <item name="android:textViewStyle">@style/AppTextViewStyle</item>
        <item name="materialButtonStyle">@style/AppButtonStyle</item>
        
        <!-- Card Style -->
        <item name="materialCardViewStyle">@style/AppCardStyle</item>
    </style>

    <style name="SplashScreenTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/splash_screen_background</item>
        <item name="android:statusBarColor">@color/bankpay_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:immersive">true</item>
    </style>
</resources>
