<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Colors -->
        <item name="colorPrimary">@color/bankpay_primary</item>
        <item name="colorPrimaryDark">@color/bankpay_secondary</item>
        <item name="colorAccent">@color/bankpay_accent</item>
        <item name="colorSurface">@color/cardBackground</item>
        <item name="android:colorBackground">@color/colorActivityWhiteBackground</item>
        
        <!-- Status Bar -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/colorActivityWhiteBackground</item>
        
        <!-- Typography -->
        <item name="android:textViewStyle">@style/AppTextViewStyle</item>
        <item name="materialButtonStyle">@style/AppButtonStyle</item>
        
        <!-- Card Style -->
        <item name="materialCardViewStyle">@style/AppCardStyle</item>
    </style>

    <style name="AppTextViewStyle" parent="Widget.MaterialComponents.TextView">
        <item name="android:textColor">@color/matt_black</item>
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@font/poppins_regular</item>
    </style>

    <style name="AppButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="fontFamily">@font/poppins_semi_bold</item>
    </style>

    <style name="AppCardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="contentPadding">16dp</item>
        <item name="cardBackgroundColor">@color/cardBackground</item>
    </style>

    <style name="SplashScreenTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/splash_screen_background</item>
        <item name="android:statusBarColor">@color/bankpay_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:immersive">true</item>
    </style>
</resources>
